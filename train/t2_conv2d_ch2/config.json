{
    "name": "baseline",
    "batch_size":32,
    "seed":42,
    "manifest_path":"/home/furkan/projects/mebar-radiology/preprocessing/configurations/no_alignment/images_2d/manifest.csv",
    "optimizer":{
        "name":"adamw",
